+		// FSMP can omit an otherwise continuous manifold for an isolated frame.
+		// Preserve one representative per rigid-body pair for three missing frames,
+		// fading penetration only.  This is deliberately bounded and allocation-free
+		// because it runs on the physics thread.
+		constexpr std::size_t kContinuityPairCapacity =
+			gt::contact::ContactFrameCollector::kPublishedCapacity;
+		constexpr std::uint64_t kContinuityMissingFrameTtl = 3U;
+		constexpr float kContinuityDecayDivisor =
+			static_cast<float>(kContinuityMissingFrameTtl + 1U);
