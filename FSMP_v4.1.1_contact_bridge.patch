diff -ruN up_v4.1.1/src/GTContactFrameTiming.h mine_v4.1.1/src/GTContactFrameTiming.h
--- up_v4.1.1/src/GTContactFrameTiming.h	1970-01-01 09:00:00.000000000 +0900
+++ mine_v4.1.1/src/GTContactFrameTiming.h	2026-09-29 20:40:18.744677400 +0900
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+namespace hdt::gtcontact
+{
+	// Keep this value shared with SkinnedMeshWorld::stepSimulation.  Contact
+	// frames must advertise the number of Bullet substeps that will actually be
+	// executed; otherwise every contact from substep 1+ is rejected by ABI v1.
+	inline constexpr float kMinimumSimulationPeriod = 1.0F / 300.0F;
+
+	[[nodiscard]] inline std::uint32_t CalculateSimulationSubstepCount(
+		const float totalTimeStep,
+		const float fixedTimeStep) noexcept
+	{
+		if (!std::isfinite(totalTimeStep) || !std::isfinite(fixedTimeStep) ||
+			totalTimeStep <= 0.0F || fixedTimeStep <= 0.0F) {
+			return 0U;
+		}
+
+		float remaining = totalTimeStep;
+		std::uint32_t count = 0U;
+		while (remaining > fixedTimeStep) {
+			if (count == std::numeric_limits<std::uint32_t>::max()) {
+				return count;
+			}
+			const float next = remaining - fixedTimeStep;
+			// Guard pathological floating-point inputs from making the counting
+			// loop non-progressing.  Normal FSMP input is bounded to maxSubSteps.
+			if (!(next < remaining)) {
+				return std::numeric_limits<std::uint32_t>::max();
+			}
+			remaining = next;
+			++count;
+		}
+
+		if (remaining > kMinimumSimulationPeriod &&
+			count != std::numeric_limits<std::uint32_t>::max()) {
+			++count;
+		}
+		return count;
+	}
+}
